# Isabella Wellness AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com

# Database
DATABASE_URL=postgresql://isabella:change_this_password@postgres:5432/isabella_db

# Authentication — minimum 64 characters in production
JWT_SECRET=change_this_to_64_character_minimum_random_string_in_production_do_not_use_this

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# VaultACE (leave empty for community edition)
VAULTACE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_DEVELOPER=price_id_here
STRIPE_PRICE_PROFESSIONAL=price_id_here
STRIPE_PRICE_ENTERPRISE=price_id_here

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_DEVELOPER=
PAYPAL_PLAN_PROFESSIONAL=
PAYPAL_PLAN_ENTERPRISE=

# Admin
ADMIN_API_KEY=change_this_in_production

# Logging
LOG_LEVEL=info
